# ─── Database (Neon Postgres) ───
# REQUIRED for waitlist / design-partner form submissions.
# Create a free DB at https://neon.tech and paste the connection string here.
# Vercel: add this as POSTGRES_URL in Settings → Environment Variables.
POSTGRES_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Email (Resend) ───
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Optional overrides
# WAITLIST_NOTIFY_TO=hello@trucore.xyz
# WAITLIST_FROM=TruCore <hello@trucore.xyz>

# ─── Design Partner ───
# Scheduling link shown after successful design-partner application.
# DESIGN_PARTNER_SCHEDULING_URL=https://cal.com/your-link

# ─── Firewall API (server-side only, do not expose as NEXT_PUBLIC) ───
FIREWALL_API_BASE_URL=http://localhost:8000
# Optional if firewall API requires authentication
# FIREWALL_API_API_KEY=your_server_side_api_key

# ─── ATF public base URL (used for documentation / curl examples) ───
# The real API calls go through the server-side proxy (FIREWALL_API_BASE_URL).
NEXT_PUBLIC_API_BASE=https://api.trucore.xyz

# ─── Internal Health Monitor (cross-service) ───
# ATF_HEALTH_URL: ATF backend health endpoint (default: https://api.trucore.xyz/health)
# ALERT_EMAIL_TO: recipient for alert emails (required to enable monitor)
# ALERT_EMAIL_FROM: sender address (default: TruCore Monitor <alerts@trucore.xyz>)
# HEALTH_CHECK_TIMEOUT_MS: fetch timeout in ms (default: 5000)
# FAILURE_THRESHOLD: consecutive failures before alerting (default: 3)
#
# ATF_HEALTH_URL=https://api.trucore.xyz/health
# ALERT_EMAIL_TO=info@trucore.xyz
# ALERT_EMAIL_FROM=TruCore Monitor <alerts@trucore.xyz>
# HEALTH_CHECK_TIMEOUT_MS=5000
# FAILURE_THRESHOLD=3
