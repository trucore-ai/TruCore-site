# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage/
/.nyc_output/

# next.js
/.next/
/out/
/dist/

# production
/build

# misc
.DS_Store
*.pem
*Zone.Identifier
.lighthouseci/
lighthouse.*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.test is safe to commit — contains only NODE_OPTIONS, no secrets.
# Vitest loads it automatically; it raises the worker heap cap to 6 GB,
# which is required for the jsdom-heavy policy test files.
!.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# proof generation output (ephemeral)
docs/growth/proof-output/
.env*.local

# stray debug/verify scripts
_verify_key.mjs
