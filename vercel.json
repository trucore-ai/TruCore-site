{
  "crons": [
    {
      "path": "/api/internal/health-monitor",
      "schedule": "0 0 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "trucore.xyz"
        }
      ],
      "destination": "https://www.trucore.xyz/:path*",
      "permanent": true
    }
  ]
}
