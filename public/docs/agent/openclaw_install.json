{
    "schema_version": "1",
    "package_name": "@trucore/trucore-atf",
    "plugin_id": "trucore-atf",
    "version": "0.2.11",
    "product": "TruCore ATF OpenClaw Plugin",
    "install": {
        "openclaw_gateway": {
            "command": "openclaw plugins install @trucore/trucore-atf",
            "post_install": "openclaw gateway restart",
            "description": "Install via OpenClaw gateway (recommended)"
        },
        "npm": {
            "command": "npm i @trucore/trucore-atf@0.2.11",
            "description": "Install via npm (pinned version)"
        }
    },
    "onboarding": {
        "type": "zero-env",
        "claim_flow": "browser/device",
        "steps": [
            {
                "step": 1,
                "command": "openclaw plugins install @trucore/trucore-atf",
                "description": "Install the plugin"
            },
            {
                "step": 2,
                "command": "openclaw gateway restart",
                "description": "Restart the OpenClaw gateway to load the plugin"
            },
            {
                "step": 3,
                "command": "atf_setup",
                "description": "Initialize plugin and local config (zero-env, no environment variables required)"
            },
            {
                "step": 4,
                "action": "claim_in_browser",
                "description": "Complete browser/device claim flow to bind this agent to a TruCore account"
            },
            {
                "step": 5,
                "command": "atf_claim_status",
                "description": "Verify the claim was accepted and credentials are persisted locally"
            },
            {
                "step": 6,
                "command": "atf_whoami",
                "description": "Confirm agent identity and credential persistence"
            },
            {
                "step": 7,
                "command": "atf_bot_preflight",
                "description": "Run pre-session readiness check: CLI, policy, and network operational"
            },
            {
                "step": 8,
                "command": "atf_integration_doctor",
                "description": "Full integration health check: plugin loading, config, backend connectivity"
            }
        ]
    },
    "verification_sequence": [
        {"step": 1, "command": "atf_setup", "description": "Initialize plugin and local config"},
        {"step": 2, "action": "claim_in_browser", "description": "Complete browser/device claim flow"},
        {"step": 3, "command": "atf_claim_status", "description": "Verify claim was accepted"},
        {"step": 4, "command": "atf_whoami", "description": "Confirm identity and credential persistence"},
        {"step": 5, "command": "atf_bot_preflight", "description": "Run pre-session readiness check"},
        {"step": 6, "command": "atf_integration_doctor", "description": "Full integration health check"}
    ],
    "expected_behavior": {
        "zero_env_onboarding": true,
        "browser_device_claim_flow": true,
        "local_credential_persistence": true,
        "deny_by_default_enforcement": true,
        "deterministic_policy_decisions": true
    },
    "deny_behavior_note": "Deny decisions such as CHAIN_NOT_SUPPORTED are policy behavior, not runtime failure. Agents should interpret deny reason codes as expected policy enforcement.",
    "migration": {
        "previous_package_name": "@trucore/openclaw-atf",
        "current_package_name": "@trucore/trucore-atf",
        "note": "The package was renamed from @trucore/openclaw-atf to @trucore/trucore-atf. Update your install commands accordingly."
    },
    "version_guidance": {
        "current": "0.2.11",
        "minimum_recommended": "0.2.11",
        "install_latest": "openclaw plugins install @trucore/trucore-atf",
        "install_pinned": "npm i @trucore/trucore-atf@0.2.11"
    },
    "related_assets": {
        "manifest": "/.well-known/atf.json",
        "toolcard": "/docs/agent/atf_toolcard.json",
        "plugin_info": "/docs/agent/openclaw_plugin.json",
        "agent_discovery_docs": "/docs/agent-discovery",
        "plugin_docs": "/docs/openclaw-plugin"
    },
    "contact": {
        "x": "https://x.com/TruCore_AI",
        "github": "https://github.com/TruCore-AI",
        "bot_feedback": "https://trucore.xyz/api/bot-feedback",
        "human_feedback": "https://trucore.xyz/feedback"
    }
}
