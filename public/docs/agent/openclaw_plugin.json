    "product": "TruCore ATF OpenClaw Plugin",
    "description": "OpenClaw plugin for TruCore ATF. Policy-enforced transaction protection for autonomous agents. Thirteen typed tools, zero config, fail-closed by default.",
    "install_command": "openclaw plugins install @trucore/trucore-atf",
    "npm_install": "npm i @trucore/trucore-atf@0.2.11",
    "docs_url": "/docs/agent-discovery",
    "toolcard_url": "/docs/agent/atf_toolcard.json",
    "manifest_url": "/.well-known/atf.json",
    "migration": {
        "previous_package_name": "@trucore/openclaw-atf",
        "current_package_name": "@trucore/trucore-atf",
        "note": "The package was renamed from @trucore/openclaw-atf to @trucore/trucore-atf. Update your install commands accordingly."
    },
    "onboarding_flow": [
        "atf_setup",
        "atf_claim_status",
        "atf_whoami",
        "atf_bot_preflight",
        "atf_integration_doctor"
